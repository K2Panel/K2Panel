[flake8]
max-line-length = 120

ignore = E203,E501,W503,W504,F401,E722

exclude = 
    .git,
    __pycache__,
    .pytest_cache,
    .venv,
    venv,
    env,
    build,
    dist,
    *.egg-info,
    .tox,
    .eggs,
    pyenv/,
    BTPanel/,
    class/,
    class_v2/,
    data/,
    install/,
    logs/,
    mod/,
    plugin/,
    htmlcov/,
    .coverage

max-complexity = 15
statistics = True
show-source = True
count = True
